{
  "schema": "paired-medium-public.v1",
  "cases": {
    "stable-order": {
      "fn": "orderActions",
      "tests": [
        {
          "args": [
            [
              {
                "id": "visible-k",
                "priority": 1.25
              },
              {
                "id": "visible-Z",
                "priority": 1.25
              },
              {
                "id": "visible-v",
                "priority": -2
              },
              {
                "id": "visible-b",
                "priority": 0
              },
              {
                "id": "visible-h",
                "priority": null
              },
              {
                "id": "visible-d",
                "priority": "-20"
              },
              {
                "id": "visible-A"
              }
            ]
          ],
          "expected": [
            {
              "id": "visible-v",
              "priority": -2
            },
            {
              "id": "visible-b",
              "priority": 0
            },
            {
              "id": "visible-Z",
              "priority": 1.25
            },
            {
              "id": "visible-k",
              "priority": 1.25
            },
            {
              "id": "visible-A"
            },
            {
              "id": "visible-d",
              "priority": "-20"
            },
            {
              "id": "visible-h",
              "priority": null
            }
          ],
          "property": "contract"
        },
        {
          "args": [
            [
              {
                "id": "visible-r",
                "priority": false
              },
              {
                "id": "visible-B"
              },
              {
                "id": "visible-a",
                "priority": null
              },
              {
                "id": "visible-e",
                "priority": "2"
              }
            ]
          ],
          "expected": [
            {
              "id": "visible-B"
            },
            {
              "id": "visible-a",
              "priority": null
            },
            {
              "id": "visible-e",
              "priority": "2"
            },
            {
              "id": "visible-r",
              "priority": false
            }
          ],
          "property": "contract"
        },
        {
          "args": [
            [
              {
                "id": "é",
                "priority": 8
              },
              {
                "id": "z",
                "priority": 8
              },
              {
                "id": "A",
                "priority": 8
              }
            ]
          ],
          "expected": [
            {
              "id": "A",
              "priority": 8
            },
            {
              "id": "z",
              "priority": 8
            },
            {
              "id": "é",
              "priority": 8
            }
          ],
          "property": "contract"
        },
        {
          "args": [
            [
              {
                "id": "repeat",
                "priority": 1,
                "title": "before"
              },
              {
                "id": "repeat",
                "priority": 1,
                "title": "after"
              }
            ]
          ],
          "expected": [
            {
              "id": "repeat",
              "priority": 1,
              "title": "before"
            },
            {
              "id": "repeat",
              "priority": 1,
              "title": "after"
            }
          ],
          "property": "contract"
        },
        {
          "args": [
            [
              {
                "id": "repeat",
                "title": "first"
              },
              {
                "id": "repeat",
                "priority": null,
                "title": "second"
              }
            ]
          ],
          "expected": [
            {
              "id": "repeat",
              "title": "first"
            },
            {
              "id": "repeat",
              "priority": null,
              "title": "second"
            }
          ],
          "property": "contract"
        },
        {
          "argsExpression": "[[{id:\"visible-t\",priority:Infinity},{id:\"visible-f\",priority:NaN},{id:\"visible-k\",priority:-Infinity},{id:\"visible-x\",priority:0.5}]]",
          "expected": [
            {
              "id": "visible-x",
              "priority": 0.5
            },
            {
              "id": "visible-f",
              "priority": {
                "$number": "NaN"
              }
            },
            {
              "id": "visible-k",
              "priority": {
                "$number": "-Infinity"
              }
            },
            {
              "id": "visible-t",
              "priority": {
                "$number": "Infinity"
              }
            }
          ],
          "property": "contract"
        },
        {
          "args": [
            []
          ],
          "expected": [],
          "property": "contract"
        }
      ]
    },
    "device-labels": {
      "fn": "deviceLabels",
      "tests": [
        {
          "args": [
            [
              "computer"
            ]
          ],
          "expected": [
            "Computer required"
          ],
          "property": "contract"
        },
        {
          "args": [
            [
              "phone"
            ]
          ],
          "expected": [
            "Phone possible"
          ],
          "property": "contract"
        },
        {
          "args": [
            [
              "computer",
              "phone"
            ]
          ],
          "expected": [
            "Computer possible",
            "Phone possible"
          ],
          "property": "contract"
        },
        {
          "args": [
            [
              "phone",
              "tablet",
              "computer",
              "phone"
            ]
          ],
          "expected": [
            "Computer possible",
            "Phone possible"
          ],
          "property": "contract"
        },
        {
          "args": [
            [
              "computer",
              "Computer",
              "computer"
            ]
          ],
          "expected": [
            "Computer required"
          ],
          "property": "contract"
        },
        {
          "args": [
            [
              "tablet",
              "Phone"
            ]
          ],
          "expected": [],
          "property": "contract"
        },
        {
          "args": [
            []
          ],
          "expected": [],
          "property": "contract"
        },
        {
          "args": [
            null
          ],
          "expected": [],
          "property": "contract"
        },
        {
          "args": [
            "phone"
          ],
          "expected": [],
          "property": "contract"
        },
        {
          "args": [
            {}
          ],
          "expected": [],
          "property": "contract"
        }
      ]
    }
  }
}
